PORT=5001

# API + MongoDB performance logging
# API_TIMING_LOG=1 logs each request with duration and per-request DB stats (set 0 to disable)
API_TIMING_LOG=1
# DB_QUERY_LOG=1 logs every MongoDB operation; otherwise only slow queries are logged
DB_QUERY_LOG=0
# Milliseconds — queries at or above this threshold are always logged when DB_QUERY_LOG=0
DB_SLOW_QUERY_MS=100

# App environment: production (default) | QA | dev
# QA and dev enable sub-hour sequence wait options (minutes) for outreach testing.
# Unset APP_ENV defaults to dev when NODE_ENV=development, otherwise production.
APP_ENV=production

# Schedule interview reminders (recruiter notifications before upcoming bookings)
# SCHEDULE_REMINDER_ENABLED=true
# SCHEDULE_REMINDER_INTERVAL_MS=60000

# WebSocket realtime (same port as HTTP; path /ws)
REALTIME_ENABLED=true
REALTIME_WS_PATH=/ws
REALTIME_PING_MS=30000

# Comma-separated browser origins (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://dev.huntlo.online,https://huntlo.online,https://www.huntlo.online

JWT_SECRET=change-me-use-long-random-secret-in-production
JWT_EXPIRES_IN=30d

MONGODB_URI=mongodb://127.0.0.1:27017/ejhunter

FUTURE_JOBS_API_URL=https://prod.api.futurejobs.ai/api/v1
FUTURE_JOBS_API_KEY=
# FUTURE_JOBS_AUTH_STYLE=bearer | x-api-key

# Same OAuth client as NEXT_PUBLIC_GOOGLE_CLIENT_ID (secret stays server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Calendly webhook signing key (from Calendly webhook subscription settings)
# CALENDLY_WEBHOOK_SIGNING_KEY=

# Zoho Mail — OAuth (recommended) and/or SMTP app-password connect
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Defaults to {FRONTEND_URL}/integrations/zoho/callback
# ZOHO_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/zoho/callback

# Microsoft Outlook / Microsoft 365 — Graph OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Defaults to {FRONTEND_URL}/integrations/outlook/callback
# MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/outlook/callback
# Use "common" for work + personal Microsoft accounts (default)
# MICROSOFT_TENANT_ID=common

# Meta WhatsApp Cloud API (Graph)
META_GRAPH_API_VERSION=v21.0
# Must match the language shown on the template in Meta (English US is usually en_US)
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Dev only: force hello_world for all template sends
# META_WHATSAPP_FORCE_TEST_TEMPLATE=false
META_WEBHOOK_VERIFY_TOKEN=
# 10-digit phones without + are prefixed with this country code (default 91 = India)
DEFAULT_PHONE_COUNTRY_CODE=91
# Public API origin for webhook callback URL shown to users (own Meta). Falls back to request Host.
# PUBLIC_API_BASE_URL=https://api.huntlo.online

# Hunar AI voice calls (bulk outbound). Agent id is per campaign (voice editor), not env.
HUNAR_VOICE_API_KEY=
# Voice persona and language for agents created from the campaign editor
HUNAR_VOICE_PERSONA=NEHA
HUNAR_VOICE_LANGUAGE=ENGLISH

# Huntlo-managed WhatsApp — "Use Huntlo account" in Integrations (server-side only)
HUNTLO_WHATSAPP_PHONE_NUMBER_ID=
HUNTLO_WHATSAPP_ACCESS_TOKEN=
HUNTLO_WHATSAPP_WABA_ID=

# Gupshup Gateway API (when admin Settings → messaging channel = Gupshup)
# Shared fallback if reply/template-specific vars are not set:
GUPSHUP_USERID=
GUPSHUP_PASSWORD=
# Optional separate accounts (EarlyJobs Portal style):
# GUPSHUP_REPLY_USER_ID=
# GUPSHUP_REPLY_PASSWORD=
# GUPSHUP_TEMPLATE_USER_ID=
# GUPSHUP_TEMPLATE_PASSWORD=
# GUPSHUP_API_KEY=          # optional alias for passwords

# Vertex AI — copy this block into Backend/.env (not only here). project_id is read from JSON.
# Alternatives: save JSON under secrets/gcp-credentials.json | GEMINI_API_KEY=...
# Optional overrides: GCP_LOCATION, GCP_PROJECT_ID
# GEMINI_MODEL=gemini-2.5-flash
GCP_CREDENTIALS_JSON=

# Razorpay — INR plan checkout (Dashboard → Plans and pricing)
# Test keys: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dodo Payments — USD / global checkout
# Dashboard: https://app.dodopayments.com — API key + webhook secret + products
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode (default) or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product IDs from Dodo dashboard (monthly Starter $99 / Growth $399 products)
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_GROWTH=
# Return URL base after checkout (defaults to first CORS origin)
FRONTEND_URL=http://localhost:3000

# Campaign email auto-reply (Gemini) when candidates reply
OUTREACH_AUTO_REPLY_ENABLED=true
OUTREACH_AUTO_REPLY_MAX=8

# WhatsApp AI qualification on candidate replies
OUTREACH_WHATSAPP_AI_ENABLED=true
